ENVIRONMENT=development
DISCORD_TOKEN=
DISCORD_TESTING_GUILD_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Development-mode Spotify apps: authorize the operator's Spotify account using
# Authorization Code flow with playlist-read-private (and playlist-read-collaborative
# when using collaborative playlists), then put the returned refresh token here.
# https://developer.spotify.com/documentation/web-api/tutorials/code-flow
# The authorized user must own or collaborate on each selected playlist.
# The app owner must have Spotify Premium; authorize an allowed app user.
# This is one shared operator account, not a separate login per Discord player.
# All quiz users can select playlists available to this account; do not authorize
# an account with private playlists you do not want exposed to quiz participants.
# Tokens are secrets: use .env or the deployment secret store, never commit them.
# Reauthorize when Spotify rejects an expired/revoked refresh token. Rotated
# tokens are retained in memory during this process; configuration is not rewritten.
SPOTIFY_REFRESH_TOKEN=

# Leave SPOTIFY_REFRESH_TOKEN empty only for Extended Quota apps that still permit
# client-credentials access to public playlist contents. ENVIRONMENT does not
# control the Spotify app's quota mode. Public visibility alone is insufficient
# for development-mode access.
